GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Notion sync: an internal integration token from the workspace that owns the Law Database, and a long random
# string callers send as a Bearer token to POST /api/admin/sync.
NOTION_TOKEN=
ADMIN_SYNC_TOKEN=
# Turnstile on the student sign-in form. Cloudflare's always-pass test secret; production uses the
# "NotifiedLaw student sign-in" widget's secret (wrangler secret put TURNSTILE_SECRET_KEY).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
