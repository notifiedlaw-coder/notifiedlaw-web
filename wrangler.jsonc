{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notifiedlaw",
  // OpenNext's handler plus the Scanner container class.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // scheduled() in custom-worker.ts. Daily at 02:30 UTC: delete expired messages and old call records. Every five
  // minutes: end calls past their 3 hours or left without hanging up.
  "triggers": { "crons": ["30 2 * * *", "*/5 * * * *"] },
  // Profile and group pictures: decoded, cropped to 256 px and re-encoded as WebP (src/lib/avatars.ts).
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    // Public marketing videos, audio and images, served by src/app/media/[...key]/route.ts
    { "binding": "VIDEOS", "bucket_name": "notifiedlaw-videos" },
    // My Files uploads. Private: no public or r2.dev access; read only through src/app/api/files/[id]/route.ts.
    { "binding": "FILES", "bucket_name": "notifiedlaw-files" }
  ],
  "d1_databases": [
    // Users, sessions and (later) progress. Schema lives in src/db/schema.ts; migrations in ./migrations.
    { "binding": "DB", "database_name": "notifiedlaw-db", "database_id": "0a0b819f-d1f9-4c76-89ba-f2f9e330b1ae", "migrations_dir": "migrations" }
  ],
  // ClamAV for My Files uploads (scanner/Dockerfile, src/lib/scan.ts). standard-1 (4 GiB) fits clamd's signatures.
  "containers": [
    { "class_name": "Scanner", "image": "./scanner/Dockerfile", "instance_type": "standard-1", "max_instances": 1 }
  ],
  "durable_objects": { "bindings": [{ "name": "SCANNER", "class_name": "Scanner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scanner"] }],
  "send_email": [
    // Cloudflare Email Service: student sign-in links. Sends from notifiedlaw.com, which must be
    // onboarded to Email Sending (wrangler email sending enable notifiedlaw.com). Simulated under local dev.
    { "name": "EMAIL" }
  ],
  "ratelimits": [
    // Workers Rate Limiting; used by src/lib/rate-limit.ts. period is 10 or 60 seconds.
    { "name": "RL_WRITES", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_READS", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_MEDIA", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
    // Student sign-in links: per recipient and per IP (sendStudentLink in src/lib/auth.ts).
    { "name": "RL_UNI_EMAIL", "namespace_id": "1005", "simple": { "limit": 3, "period": 60 } },
    // Every Worker request, per signed-in user or else per IP (custom-worker.ts). High enough for a shared
    // campus or mobile IP of guests; going over it blocks that session or IP for 10 minutes.
    { "name": "RL_PAGES", "namespace_id": "1006", "simple": { "limit": 600, "period": 60 } },
    // TimeTable saves, per user. A person editing a calendar stays well under 12 in 10 seconds; going over
    // means a script, so src/lib/rate-limit.ts then refuses that user's calendar changes for 5 minutes.
    { "name": "RL_TIMETABLE", "namespace_id": "1007", "simple": { "limit": 12, "period": 10 } },
    // Call signalling (join, publish, subscribe, answer), per user. Joining a full group call takes a few dozen.
    { "name": "RL_CALLS", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } },
    // The same signalling for every user together (key "all"), so many free accounts cannot run up the SFU bill.
    { "name": "RL_SFU", "namespace_id": "1012", "simple": { "limit": 3000, "period": 60 } },
    // Messages sent (direct and group), per user: a fast typist, not a script.
    { "name": "RL_MESSAGES", "namespace_id": "1009", "simple": { "limit": 30, "period": 60 } },
    // Profile and group picture uploads, per user.
    { "name": "RL_AVATARS", "namespace_id": "1010", "simple": { "limit": 5, "period": 60 } },
    // Typing pings, per user: one every 3 s while typing, plus stops, with room for several chats.
    { "name": "RL_TYPING", "namespace_id": "1011", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "776945171684-51d8p7incfdsv3vfaendvmg10vo75br2.apps.googleusercontent.com",
    "BETTER_AUTH_URL": "https://notifiedlaw.com",
    // The Notion LAW DATABASE that the CMS sync reads (Notified Law Admin page).
    "NOTION_ROOT_DATABASE_ID": "4062efa9c98e80089682f3481b6c4b67",
    // Cloudflare Realtime SFU app for calls (dashboard: Realtime > SFU). Its secret is REALTIME_APP_SECRET.
    "REALTIME_APP_ID": "e259f6754e78087eeec448961473a39e"
  },
  "routes": [
    { "pattern": "notifiedlaw.com", "custom_domain": true },
    { "pattern": "www.notifiedlaw.com", "custom_domain": true } // redirected to the apex in next.config.ts
  ]

  // Add as features land (all Cloudflare-native):
  //   D1 (users, progress, quiz results)   "d1_databases"
  //   R2 (podcast audio)                   more "r2_buckets"
  //   KV (sessions, rate limits)           "kv_namespaces"
  //   Workers AI + Vectorize (Notified AI) "ai", "vectorize"
  //   Turnstile on sign-in; Email Service for receipts (binding above).
}
